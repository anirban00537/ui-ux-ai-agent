{
  "name": "butterfast-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Butterfast backend with nodejs",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "npx prisma migrate deploy && npx prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start -p 3001",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --experimental-require-module dist/main -p 3001",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "npx prisma db seed",
    "prisma:seed:templates": "npx tsx prisma/seed-templates.ts",
    "prisma:generate": "npx prisma generate",
    "dev": "nodemon src/index.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0-beta.34",
    "@aws-sdk/client-s3": "^3.676.0",
    "@aws-sdk/s3-request-presigner": "^3.676.0",
    "@distube/ytdl-core": "^4.16.4",
    "@langchain/community": "^0.3.34",
    "@langchain/core": "^0.3.42",
    "@langchain/openai": "^0.4.4",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@openrouter/sdk": "^0.3.16",
    "@polar-sh/sdk": "^0.41.5",
    "@prisma/client": "5.22.0",
    "@types/backblaze-b2": "^1.5.6",
    "ai": "^6.0.0-beta.73",
    "archiver": "^7.0.1",
    "axios": "^1.7.7",
    "backblaze-b2": "^1.7.0",
    "bcrypt": "^5.1.0",
    "better-auth": "^1.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "google-auth-library": "^9.14.2",
    "handlebars": "^4.7.7",
    "lemonsqueezy.ts": "^0.1.7",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.7.0",
    "openai": "^4.104.0",
    "partial-json": "^0.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.3",
    "pgvector": "^0.2.0",
    "pptxgenjs": "^4.0.1",
    "prisma-extension-pgvector": "^0.11.0",
    "puppeteer": "^24.35.0",
    "raw-body": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "swagger-ui-express": "^5.0.1",
    "unsplash-js": "^7.0.20",
    "uuid": "^10.0.0",
    "winston": "^3.3.3",
    "xml2js": "^0.6.2",
    "youtube-caption-scraper": "^1.0.0",
    "youtube-transcript": "^1.2.1",
    "youtube-transcript-api": "^1.1.2",
    "youtubei.js": "^13.1.0",
    "ytdl-core": "^4.11.5",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.4",
    "@types/passport": "^1.0.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.33",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.9.0",
    "@typescript-eslint/parser": "^8.9.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
