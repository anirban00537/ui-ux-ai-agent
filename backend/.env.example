# backend updated env
# Authentication
ACCESS_TOKEN_EXPIRY=90d
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_EXPIRY=90d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
JWT_SIGNATURE=your_jwt_signature

# API Keys
API_SECRET=your_api_secret
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
DEEPINFRA_API_KEY=your_deepinfra_api_key
YOUTUBE_API_KEY=your_youtube_api_key

# AWS S3 / Backblaze B2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_REGION=your_aws_region
B2_APPLICATION_KEY=your_b2_application_key
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_BUCKET_ID=your_b2_bucket_id
B2_BUCKET_NAME=your_b2_bucket_name
B2_DOWNLOAD_URL=your_b2_download_url

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# LemonSqueezy
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_lemonsqueezy_store_id
LEMONSQUEEZY_WEBHOOK_SIGNATURE=your_lemonsqueezy_webhook_signature

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://api.yourdomain.com,https://yourdomain.com

# Database
DATABASE_URL=postgres://your_db_user:your_db_password@your_db_host:5432/your_db_name?sslmode=require

# Mail
MAIL_ENCRYPTION=null
MAIL_FROM_NAME=Your Name
MAIL_HOST=smtp.mailtrap.io
MAIL_MAILER=smtp
MAIL_PASSWORD=your_mail_password
MAIL_PORT=2525
MAIL_USERNAME=your_mail_username
mail_from_address=your@email.com

# Redis
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_USERNAME=your_redis_username

# Application
PORT=3001
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILES_UPLOAD_COUNT=10
REQUEST_LIMIT_PER_MINUTE=60
